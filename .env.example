APP_ENV=local
HTTP_ADDR=:18080
DATABASE_URL=postgres://sandbox:sandbox@localhost:5432/sandbox?sslmode=disable
DATABASE_RUN_MIGRATIONS=true
AUTHN_TOKENS=dev-token
SANDBOX_DRIVER=direct
SANDBOX_WORK_DIR=/tmp/batasd-work
SANDBOX_DOCKER_IMAGE=batasd-runner:local
SANDBOX_DOCKER_BINARY=docker
SANDBOX_ISOLATE_BINARY=isolate
SANDBOX_ISOLATE_BOX_ID_START=0
SANDBOX_ISOLATE_BOX_ID_COUNT=16
SANDBOX_ISOLATE_CGROUP=true
QUEUE_WORKERS=1
CALLBACK_TIMEOUT_MS=5000
LIMIT_CPU_TIME_MS=5000
LIMIT_CPU_EXTRA_MS=1000
LIMIT_WALL_TIME_MS=10000
LIMIT_MEMORY_KB=128000
LIMIT_STACK_KB=64000
LIMIT_MAX_PROCESSES=60
LIMIT_MAX_OUTPUT_KB=1024
LIMIT_MAX_FILE_KB=1024
LIMIT_NETWORK=false
LIMIT_RUNS=1
MAX_LIMIT_CPU_TIME_MS=15000
MAX_LIMIT_CPU_EXTRA_MS=3000
MAX_LIMIT_WALL_TIME_MS=30000
MAX_LIMIT_MEMORY_KB=2097152
MAX_LIMIT_STACK_KB=64000
MAX_LIMIT_MAX_PROCESSES=256
MAX_LIMIT_MAX_OUTPUT_KB=4096
MAX_LIMIT_MAX_FILE_KB=10240
MAX_LIMIT_NETWORK=false
MAX_LIMIT_RUNS=20
